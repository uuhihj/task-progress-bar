{
  "name": "dsh-progress-widget",
  "version": "0.3.0",
  "description": "鲸程（Whale Run）：给 DeepSeek Harness 的任务进度条——阶段、百分比、当前动作、已用时间与预计剩余一目了然；多会话独立跟踪，子智能体任务默认折叠不刷屏。独立悬浮窗，不侵入 dsh 界面。",
  "keywords": ["dsh", "deepseek-harness", "plugin", "progress", "task-progress", "progress-bar", "eta", "widget", "agent", "task-tracker", "鲸程", "进度条", "subagent"],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "files": ["lib/index.js", "lib/client.js", "cordis.patch.yml", "README.md", "LICENSE"],
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "test": "node test/subagent-tasks.test.mjs && node test/optimizations.test.mjs && node test/client-subagent.test.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "inject": [], "platform": "web", "immediately": true }
  },
  "author": "uuhihj",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uuhihj/task-progress-bar.git"
  },
  "homepage": "https://github.com/uuhihj/task-progress-bar#readme",
  "bugs": {
    "url": "https://github.com/uuhihj/task-progress-bar/issues"
  }
}
